<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="1000.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sysproduto.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Sistema de Cadastro de Produtos" style="-fx-font-size: 16px;" />
      <GridPane hgap="12.0" maxWidth="Infinity" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints halignment="LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="280.0" />
            <ColumnConstraints halignment="LEFT" minWidth="140.0" prefWidth="140.0" maxWidth="140.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="280.0" />
         </columnConstraints>
         <children>
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Código:" />
            <TextField fx:id="txtCodigo" promptText="Digite o Código:" GridPane.columnIndex="1" />
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Nome:" GridPane.rowIndex="1" />
            <TextField fx:id="txtNome" promptText="Digite o nome do produto:" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Descrição:" GridPane.rowIndex="2" />
            <TextArea fx:id="txtDescricao" prefHeight="60.0" prefRowCount="2" wrapText="true" promptText="Descreva o produto:" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Preço de Compra:" GridPane.rowIndex="3" />
            <TextField fx:id="txtPrecoCompra" promptText="Ex: 25,90" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Preço de Venda:" GridPane.rowIndex="4" />
            <TextField fx:id="txtPrecoVenda" promptText="Ex: 39,90" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label alignment="CENTER_LEFT" minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="Quantidade em Estoque:" GridPane.rowIndex="5" />
            <TextField fx:id="txtQuantidadeEstoque" promptText="Ex: 10" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label alignment="CENTER_LEFT" minWidth="140.0" prefWidth="140.0" maxWidth="140.0" text="Data de Fabricação:" GridPane.columnIndex="2" />
            <DatePicker fx:id="dpDataFabricacao" maxWidth="Infinity" promptText="Selecione a data:" GridPane.columnIndex="3" />
            <Label alignment="CENTER_LEFT" minWidth="140.0" prefWidth="140.0" maxWidth="140.0" text="Data de Validade:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <DatePicker fx:id="dpDataValidade" maxWidth="Infinity" promptText="Selecione a data:" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <Label alignment="CENTER_LEFT" minWidth="140.0" prefWidth="140.0" maxWidth="140.0" text="Categoria:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <ComboBox fx:id="cbCategoria" maxWidth="Infinity" promptText="Selecione uma categoria:" GridPane.columnIndex="3" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <HBox alignment="CENTER" spacing="6.0">
         <children>
            <Button fx:id="btnNovo" minWidth="-Infinity" mnemonicParsing="false" onAction="#onClickNovo" text="Novo" />
            <Button fx:id="btnCadastrar" minWidth="-Infinity" mnemonicParsing="false" onAction="#onClickCadastrar" text="Cadastrar" />
            <Button fx:id="btnAtualizar" minWidth="-Infinity" mnemonicParsing="false" onAction="#onClickAtualizar" text="Atualizar" />
            <Button fx:id="btnExcluir" minWidth="-Infinity" mnemonicParsing="false" onAction="#onClickExcluir" text="Excluir" />
            <Button fx:id="btnSalvar" minWidth="-Infinity" mnemonicParsing="false" onAction="#onClickSalvar" text="Salvar" />
            <TextField fx:id="txtConsulta" minWidth="135.0" prefWidth="155.0" promptText="Consultar por código" onAction="#onClickConsultar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnConsultar" minWidth="-Infinity" text="Consultar" onAction="#onClickConsultar" />
            <Button fx:id="btnListarTodos" minWidth="-Infinity" text="Listar todos" onAction="#onClickListarTodos" />
            <Button fx:id="btnRelatorios" minWidth="-Infinity" text="Relatórios" onAction="#onClickRelatorios" />
         </children>
      </HBox>
      <TableView fx:id="tblProdutos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Código" />
          <TableColumn fx:id="colNome" prefWidth="75.0" text="Nome" />
            <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
            <TableColumn fx:id="colPrecoCompra" prefWidth="75.0" text="Preço de Compra" />
            <TableColumn fx:id="colPrecoVenda" prefWidth="75.0" text="Preço de Venda" />
            <TableColumn fx:id="colEstoque" prefWidth="75.0" text="Estoque" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="lblStatus" text="Selecione um produto para editar ou clique em Novo." wrapText="true" />
   </children>
</VBox>
